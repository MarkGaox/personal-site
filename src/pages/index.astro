---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import { site } from '../site';
import { getPosts, formatDate, url } from '../lib';

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <div class="wrap">
    <Print size="hero" develop>
      <h1 class="name">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
    </Print>
  </div>

  <div class="wrap">
    <section class="section">
      <h2>About</h2>
      <div class="prose lede">
        {site.intro.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="section">
      <h2>Lately</h2>
      <ul class="prose now">
        {site.now.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section">
      <h2>Writing</h2>
      <div>
        {posts.length === 0 ? (
          <p>Nothing published yet. The first post is on its way.</p>
        ) : (
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href={url(`/blog/${p.id}/`)}>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <span class="t">{p.data.title}</span>
                  {p.data.summary && <span class="s">{p.data.summary}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
        <p class="all"><a href={url('/blog/')}>Read all posts</a></p>
      </div>
    </section>

    <section class="section">
      <h2>Elsewhere</h2>
      <ul class="links">
        {site.links.map((l) => (
          <li><a href={l.href.startsWith('/') ? url(l.href) : l.href}>{l.label}</a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .name {
    margin: 0;
    font-size: clamp(3.6rem, 17vw, 11.5rem);
    font-weight: 760;
    font-variation-settings: 'wdth' 76, 'opsz' 96;
    line-height: 0.86;
    letter-spacing: -0.035em;
    max-width: 8ch;
  }
  .tagline {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    max-width: 30ch;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.35;
    font-style: italic;
  }
  .lede p:first-child { font-size: 1.15em; }
  .now { list-style: none; padding: 0; margin: 0; }
  .now li { padding-left: 1.4em; position: relative; margin-bottom: 0.5em; }
  .now li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 0.6em; height: 0.6em; border-radius: 50%;
    background: var(--ferric);
  }
  .all { margin: 1.25rem 0 0; font-family: var(--display); }
  .links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; font-family: var(--display); font-size: 1.15rem; }
</style>
