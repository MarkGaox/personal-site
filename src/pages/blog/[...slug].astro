---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Print from '../../components/Print.astro';
import { getPosts, formatDate, readingMinutes, url, type Post } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---
<Base title={post.data.title} description={post.data.summary}>
  <article>
    <div class="wrap">
      <Print size="band">
        <h1 class="post-title">{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>, {minutes} min read
          {post.data.draft && <strong>, draft</strong>}
        </p>
      </Print>
    </div>
    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>
      {post.data.tags.length > 0 && (
        <p class="tags">Filed under {post.data.tags.join(', ')}</p>
      )}
    </div>
    {(older || newer) && <nav class="wrap pager" aria-label="More posts">
      {older ? <a href={url(`/blog/${older.id}/`)} rel="prev"><span>Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="newer" href={url(`/blog/${newer.id}/`)} rel="next"><span>Newer</span>{newer.data.title}</a>}
    </nav>}
  </article>
</Base>

<style>
  .post-title {
    margin: 0; max-width: 20ch;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    font-variation-settings: 'wdth' 80, 'opsz' 96;
    font-weight: 720; letter-spacing: -0.03em; line-height: 0.98;
  }
  .meta { margin: 1.25rem 0 0; font-family: var(--display); font-size: 1rem; opacity: 0.85; }
  .body { padding-block: clamp(2.5rem, 6vw, 4rem) 1rem; }
  .body .prose { margin-inline: auto; }
  @media (min-width: 60rem) { .body .prose { margin-left: 15rem; } .tags { margin-left: 15rem !important; } }
  .tags { max-width: var(--measure); margin: 2rem auto 0; color: var(--ink-soft); font-style: italic; }
  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    padding-block: 2.5rem 3rem; border-top: 1px solid var(--rule); margin-top: 3rem;
  }
  .pager a { font-family: var(--display); font-weight: 600; font-size: 1.1rem; line-height: 1.3; color: inherit; text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
  .pager span { display: block; font-weight: 400; font-size: 0.9rem; color: var(--ink-soft); }
  .pager .newer { text-align: right; grid-column: 2; }
</style>
