---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, readingMinutes, url, type Post } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---
<Base title={post.data.title} description={post.data.summary}>
  <article>
    <a class="back" href={url('/blog/')} data-reveal style="--i: 0"><Icon name="back" /> Writing</a>
    <header data-reveal style="--i: 1">
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">/</span>
        <span>{minutes} min read</span>
        {post.data.draft && <span class="draft">Draft</span>}
      </p>
    </header>
    <div class="prose" data-reveal style="--i: 2">
      <Content />
    </div>
    {post.data.tags.length > 0 && (
      <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
    )}
  </article>

  {(older || newer) && (
    <nav class="pager" aria-label="More posts">
      {older ? <a href={url(`/blog/${older.id}/`)} rel="prev"><span>Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="newer" href={url(`/blog/${newer.id}/`)} rel="next"><span>Newer</span>{newer.data.title}</a>}
    </nav>
  )}
</Base>

<style>
  .back {
    display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0 2.5rem -0.6rem;
    padding: 0.35rem 0.7rem; border-radius: 999px;
    font-size: 0.875rem; font-weight: 500; color: var(--muted); text-decoration: none;
    transition: color .2s ease, background-color .2s ease;
  }
  .back:hover { color: var(--text); background: var(--hover); }
  .back :global(svg) { width: 15px; height: 15px; }
  h1 { font-size: clamp(1.75rem, 1.35rem + 1.8vw, 2.4rem); letter-spacing: -0.035em; line-height: 1.15; text-wrap: balance; }
  .meta { display: flex; gap: 0.5rem; align-items: center; margin: 0.9rem 0 2.75rem; color: var(--faint); font-size: 0.9rem; }
  .draft { color: var(--accent); font-weight: 500; }
  .tags { list-style: none; padding: 0; margin: 2.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li { font-size: 0.8rem; font-weight: 500; color: var(--muted); padding: 0.25rem 0.7rem; border-radius: 999px; border: 1px solid var(--border); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 4rem; }
  .pager a {
    display: block; padding: 1rem 1.1rem; border-radius: 14px; text-decoration: none;
    border: 1px solid var(--border); background: var(--surface);
    font-weight: 500; line-height: 1.4; transition: border-color .2s ease;
  }
  .pager a:hover { border-color: color-mix(in srgb, var(--text) 18%, var(--border)); }
  .pager span { display: block; font-size: 0.8rem; color: var(--faint); margin-bottom: 0.2rem; font-weight: 400; }
  .pager .newer { grid-column: 2; text-align: right; }
</style>
