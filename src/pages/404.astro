---
import Base from '../layouts/Base.astro';
import { url } from '../lib';
---
<Base title="Page not found">
  <div class="wrap" style="padding-block: 4rem 6rem; max-width: 40rem;">
    <h1 style="font-size: clamp(2.5rem, 8vw, 5rem); margin: 0 0 1rem;">This page washed out.</h1>
    <p>There’s nothing at this address. It may have moved, or the link may have a typo.</p>
    <p><a href={url('/')}>Go to the home page</a> or <a href={url('/blog/')}>browse all writing</a>.</p>
  </div>
</Base>
