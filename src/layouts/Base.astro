---
import '../styles/global.css';
import { site } from '../site';
import { url } from '../lib';

interface Props { title?: string; description?: string; nav?: 'paper' | 'none' }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <header class="wrap">
      <nav class="site-nav" aria-label="Main">
        <a class="home" href={url('/')} aria-current={path === url('/') ? 'page' : undefined}>{site.name}</a>
        <a href={url('/blog/')} aria-current={path.startsWith(url('/blog/')) ? 'page' : undefined}>Writing</a>
        <a href={url('/rss.xml')}>RSS</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <button class="theme-toggle" type="button" id="theme-toggle">Switch to dark</button>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const label = () => { btn.textContent = isDark() ? 'Switch to light' : 'Switch to dark'; };
        label();
        btn.addEventListener('click', () => {
          root.dataset.theme = isDark() ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          label();
        });
      })();
    </script>
  </body>
</html>
